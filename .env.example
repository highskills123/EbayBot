# eBay API credentials
# Register at https://developer.ebay.com/ to get these values

# App credentials
EBAY_APP_ID=your_app_id_here
EBAY_DEV_ID=your_dev_id_here
EBAY_CERT_ID=your_cert_id_here

# User token (generated via eBay OAuth)
EBAY_USER_TOKEN=your_user_token_here

# Set to True for sandbox, False for production
EBAY_SANDBOX=True

# Bot polling interval in seconds (default: 300 = 5 minutes)
BOT_POLL_INTERVAL=300

# Bot logs a low-stock warning when a listing's quantity drops below this number
LOW_STOCK_THRESHOLD=5
